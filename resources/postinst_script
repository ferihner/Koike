#!/bin/sh
set -e

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ]; then
    update-alternatives --install /usr/bin/x-www-browser \
        x-www-browser /opt/Koike/koike 80
    chown root /opt/Koike/chrome-sandbox
    chmod 4755 /opt/Koike/chrome-sandbox
    echo "Run sudo xdg-settings set default-web-browser koike.desktop && sudo update-alternatives --config x-www-browser to set Koike as your default browser."
    ln -sf /opt/Koike/koike /usr/bin/koike
fi
